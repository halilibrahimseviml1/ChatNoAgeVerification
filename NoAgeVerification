local lastProcessedId = 0
task.spawn(function()
    while task.wait(3) do
        if http_request then
            pcall(function()
                http_request({
                    Url = API_URL .. "/ping",
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({
                        username = localPlayer.Name,
                        userId = localPlayer.UserId
                    })
                })

                local response = http_request({ Url = API_URL .. "/get", Method = "GET" })
                if response and response.Body then
                    local data = HttpService:JSONDecode(response.Body)
                    
                    if type(data) == "table" then
                        if data.bannedList and type(data.bannedList) == "table" then
                            for k, info in pairs(data.bannedList) do
                                settings.bannedUsers[k] = true
                                if info.userId then
                                    settings.bannedUsers[tostring(info.userId)] = true
                                end
                            end
                        end

                        if settings.bannedUsers[localPlayer.Name] or settings.bannedUsers[tostring(localPlayer.UserId)] or (data.bannedList and (data.bannedList[localPlayer.Name] or data.bannedList[tostring(localPlayer.UserId)])) then
                            if not settings.isBanned then
                                settings.isBanned = true
                                mainFrame.Visible = false
                                bannedFrame.Visible = true
                            end
                        end

                        local msgList = data.messages or data
                        if type(msgList) == "table" and not settings.isBanned then
                            for _, msg in ipairs(msgList) do
                                local msgId = msg.id or 0
                                if msgId > lastProcessedId then
                                    lastProcessedId = msgId

                                    if msg.sender and msg.message then
                                        if settings.bannedUsers[msg.sender] or (msg.senderId and settings.bannedUsers[tostring(msg.senderId)]) then
                                            continue
                                        end

                                        if msg.message:sub(1, 12) == "/ban_target " then
                                            local targetBanned = msg.message:sub(13)
                                            addMessage("System", "halilibrahimseviml1 banned " .. targetBanned, true, false)
                                        elseif msg.message:sub(1, 14) == "/unban_target " then
                                            local targetUnbanned = msg.message:sub(15)
                                            addMessage("System", "halilibrahimseviml1 unbanned " .. targetUnbanned, true, false)
                                        elseif msg.sender ~= localPlayer.Name then
                                            local isLink = msg.message:find("scriptblox.com") ~= nil
                                            addMessage(msg.sender, msg.message, false, isLink)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

