    elseif moderators[senderName] then
        titlePrefix = "[🛡️Admin] "
        textLabel.TextColor3 = Color3.fromRGB(80, 180, 255)
    elseif isSystem then
        titlePrefix = "[System] "
        textLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
    end

    local authorStr = isSystem and titlePrefix or (titlePrefix .. senderName .. ": ")
    textLabel.Text = authorStr .. tostring(messageText)

    if hasCopyButton then
        local copyBtn = Instance.new("TextButton")
        copyBtn.Size = UDim2.new(0, 40, 0, 18)
