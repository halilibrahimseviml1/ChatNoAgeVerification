            copyToClipboard(TARGET_LINK)
        end)
    end

    scrollToBottom()
end

local function sendToRenderAPI(msgText, isCmd)
    if not http_request then return end
    task.spawn(function()
        pcall(function()
            local response = http_request({
                Url = API_URL .. "/send",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({
                    sender = localPlayer.Name,
                    senderId = localPlayer.UserId,
                    message = msgText,
                    isCommand = isCmd
                })
            })
            if response and response.StatusCode == 403 then
                settings.isBanned = true
                mainFrame.Visible = false
                bannedFrame.Visible = true
            end
        end)
    end)
end

local function sendMessage()
    if settings.isBanned then return end

    local msg = textBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if msg ~= "" then
        if tick() - lastMessageTime < SPAM_COOLDOWN then return end
        lastMessageTime = tick()

        if msg:sub(1, 5) == "/ban " then
            if hasPermission(localPlayer.Name) then
                local target = msg:sub(6):gsub("^%s*(.-)%s*$", "%1")
                local targetId = 0
                pcall(function()
                    if tonumber(target) then
                        targetId = tonumber(target)
                    else
                        targetId = Players:GetUserIdFromNameAsync(target)
                    end
                end)

                settings.bannedUsers[target] = true
                if targetId > 0 then
                    settings.bannedUsers[tostring(targetId)] = true
                end
                
                local sysMsg = "halilibrahimseviml1 banned " .. target
                addMessage("System", sysMsg, true, false)
                sendToRenderAPI("/ban_target " .. target, true)
                
                pcall(function()
                    local payload = HttpService:JSONEncode({
                        target = target,
                        targetId = targetId,
                        moderator = localPlayer.Name,
                        moderatorId = localPlayer.UserId
                    })
                    http_request({
                        Url = API_URL .. "/ban",
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = payload
                    })
                end)

                textBox.Text = ""
                return
            end
        end

        if msg:sub(1, 7) == "/unban " then
            if hasPermission(localPlayer.Name) then
                local target = msg:sub(8):gsub("^%s*(.-)%s*$", "%1")
                settings.bannedUsers[target] = nil
                
                local sysMsg = "halilibrahimseviml1 unbanned " .. target
                addMessage("System", sysMsg, true, false)
                sendToRenderAPI("/unban_target " .. target, true)
                
                pcall(function()
                    local payload = HttpService:JSONEncode({
                        target = target,
                        moderatorId = localPlayer.UserId
                    })
                    http_request({
                        Url = API_URL .. "/unban",
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = payload
                    })
                end)

                textBox.Text = ""
                return
            end
        end

        addMessage(localPlayer.Name, msg, false, false)
        sendToRenderAPI(msg, false)
        textBox.Text = ""
    end
end

